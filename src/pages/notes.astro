---
import { render } from 'astro:content';
import { getNotes, groupNotesByYear } from '~/lib/notes';
import { formatDateTime } from '~/lib/format';
import { href, tagPath } from '~/lib/url';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';

const notes = await getNotes();
const groups = groupNotesByYear(notes);

// 构建时渲染好正文，页面上零额外请求
const rendered = new Map(
  await Promise.all(
    notes.map(async (note) => [note.id, (await render(note)).Content] as const),
  ),
);
---

<BaseLayout title="动态" description="一些不值得单独成篇的短想法。">
  <div class="mx-auto max-w-page px-5 sm:px-8 py-10 sm:py-12">
    <PageHeader
      title="动态"
      description="一些不值得单独成篇的短想法，按时间倒序。"
      meta={`共 ${notes.length} 条`}
    />

    {
      notes.length > 0 && (
        <a
          href={href('/notes/rss.xml')}
          class="mt-4 inline-flex items-center gap-1.5 meta-text transition-colors hover:text-accent"
        >
          <Icon name="rss" size={13} />
          单独订阅动态
        </a>
      )
    }

    {/* Pagefind 按页建索引，动态没独立页面，故整条时间线作为一条记录 */}
    {
      groups.length > 0 ? (
        <div class="mt-9 flex flex-col gap-9" data-pagefind-body data-pagefind-meta="title:动态">
          {groups.map((group) => (
            <section>
              <h2 class="mb-4 flex items-center gap-2.5 text-[0.8rem] font-semibold tracking-widest text-ink-faint">
                <span class="tabular-nums">{group.year}</span>
                <span class="h-px flex-1 bg-line" aria-hidden="true" />
              </h2>

              <ol class="note-timeline">
                {group.notes.map((note) => {
                  const Content = rendered.get(note.id);
                  return (
                    <li class="note-item">
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 meta-text">
                        <span class="flex items-center gap-1.5">
                          <Icon name="clock" size={13} class="text-ink-faint" />
                          <time datetime={note.data.pubDate.toISOString()}>
                            {formatDateTime(note.data.pubDate)}
                          </time>
                        </span>
                        {note.data.mood && (
                          <span class="flex items-center gap-1.5">
                            <Icon name="sparkle" size={13} class="text-ink-faint" />
                            {note.data.mood}
                          </span>
                        )}
                      </div>

                      <div class="prose prose-note mt-2">{Content && <Content />}</div>

                      {note.data.tags.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {note.data.tags.map((tag) => (
                            <a href={tagPath(tag)} class="tag-chip">
                              #{tag}
                            </a>
                          ))}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <p class="mt-8 text-ink-soft">
          还没有动态。在 <code class="rounded bg-paper-sunken px-1.5 py-0.5 text-sm">src/content/notes/</code>{' '}
          下新建 Markdown 文件即可。
        </p>
      )
    }
  </div>
</BaseLayout>
