---
import { getPosts, groupByYear } from '~/lib/posts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import PostRow from '~/components/PostRow.astro';

// 归档按真实时间顺序展示，不受置顶影响
const posts = await getPosts();
const groups = groupByYear(posts);
---

<BaseLayout title="归档" description="按年份浏览这个博客的全部文章。">
  <div class="mx-auto max-w-page px-5 sm:px-8 py-10 sm:py-12">
    <PageHeader
      title="归档"
      description="所有文章的时间线，按年份倒序排列。"
      meta={`共 ${posts.length} 篇`}
    />

    {
      groups.length > 0 ? (
        <div class="mt-9 flex flex-col gap-10">
          {groups.map((group) => (
            <section>
              <div class="flex items-baseline gap-3 border-b border-line pb-2">
                <h2 class="font-bold text-xl text-ink-strong tabular-nums">
                  {group.year}
                </h2>
                <span class="meta-text">{group.posts.length} 篇</span>
              </div>
              <ul class="mt-2 flex flex-col">
                {group.posts.map((post) => (
                  <PostRow post={post} />
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="mt-7 text-ink-soft">还没有发布任何文章。</p>
      )
    }
  </div>
</BaseLayout>
