---
import type { GetStaticPaths } from 'astro';
import { collectCategories, getListedPosts, type Post } from '~/lib/posts';
import { href } from '~/lib/url';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import PostCard from '~/components/PostCard.astro';
import Icon from '~/components/Icon.astro';

export const getStaticPaths = (async () => {
  const posts = await getListedPosts();
  return collectCategories(posts).map(({ name }) => ({
    params: { category: name },
    props: {
      category: name,
      posts: posts.filter((post) => post.data.category === name),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: string;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类：${category}`} description={`「${category}」分类下的全部文章。`}>
  <div class="mx-auto max-w-page px-5 sm:px-8 py-10 sm:py-12">
    <a
      href={href('/categories/')}
      class="mb-5 inline-flex items-center gap-1.5 meta-text transition-colors hover:text-accent"
    >
      <Icon name="arrowLeft" size={13} />
      全部分类
    </a>

    <PageHeader title={category} meta={`共 ${posts.length} 篇`} />

    <div class="mt-2">
      {posts.map((post) => <PostCard post={post} dense />)}
    </div>
  </div>
</BaseLayout>
