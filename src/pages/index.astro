---
import { site, author, content, social } from '~/site.config';
import { getListedPosts } from '~/lib/posts';
import { getNotes } from '~/lib/notes';
import { excerpt, formatISODate } from '~/lib/format';
import { href } from '~/lib/url';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import Icon from '~/components/Icon.astro';

const posts = await getListedPosts();
const recent = posts.slice(0, content.homePostCount);

// 动态容易被埋在二级页面里，首页放几条最新的让它更容易被看到
const recentNotes =
  content.homeNoteCount > 0 ? (await getNotes()).slice(0, content.homeNoteCount) : [];
---

<BaseLayout title={site.title} description={site.description}>
  <div class="mx-auto max-w-page px-5 sm:px-8">
    <section class="border-b border-line py-14 sm:py-16">
      <h1 class="text-[2rem] font-bold leading-tight tracking-tight text-accent sm:text-[2.45rem]">
        {site.title}
      </h1>
      <p class="mt-3 text-[1.05rem] text-ink-soft sm:text-[1.15rem]">
        {site.subtitle}
      </p>
      <p class="mt-5 max-w-[34rem] text-[0.98rem] leading-relaxed text-ink-soft">
        {site.description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <div class="flex items-center gap-2.5">
          <img
            src={href(author.avatar)}
            alt={author.name}
            width="32"
            height="32"
            class="size-8 rounded-full border border-line"
            loading="eager"
          />
          <span class="text-sm text-ink-soft">
            {author.name} · {author.bio}
          </span>
        </div>

        <div class="flex items-center gap-0.5">
          {
            social.map((item) => (
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
                class="btn-icon"
                title={item.label}
              >
                <Icon name={item.icon} size={16} title={item.label} />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-bold text-lg text-ink-strong">最近更新</h2>
        <a
          href={href('/posts/')}
          class="flex items-center gap-1 text-sm text-ink-soft transition-colors hover:text-accent"
        >
          全部文章
          <Icon name="arrowRight" size={14} />
        </a>
      </div>

      {
        recent.length > 0 ? (
          <div class="mt-2">
            {recent.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="mt-6 text-ink-soft">
            还没有文章。在 <code class="rounded bg-paper-sunken px-1.5 py-0.5 text-sm">src/content/posts/</code>{' '}
            下新建一个 Markdown 文件就可以开始写作了。
          </p>
        )
      }
    </section>

    {
      recentNotes.length > 0 && (
        <section class="border-t border-line py-10">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-lg font-bold text-ink-strong">最新动态</h2>
            <a
              href={href('/notes/')}
              class="flex items-center gap-1 text-sm text-ink-soft transition-colors hover:text-accent"
            >
              全部动态
              <Icon name="arrowRight" size={14} />
            </a>
          </div>

          <ul class="mt-4 flex flex-col gap-3">
            {recentNotes.map((note) => (
              <li>
                <a
                  href={href('/notes/')}
                  class="group flex flex-col gap-1 rounded-xl bg-paper-sunken px-4 py-3 transition-colors hover:bg-accent-soft"
                >
                  <span class="flex items-center gap-1.5 meta-text">
                    <Icon name="clock" size={12} class="text-ink-faint" />
                    <time datetime={note.data.pubDate.toISOString()}>
                      {formatISODate(note.data.pubDate)}
                    </time>
                    {note.data.mood && <span>· {note.data.mood}</span>}
                  </span>
                  <span class="line-clamp-2 text-[0.93rem] leading-relaxed text-ink transition-colors group-hover:text-accent">
                    {excerpt(note.body, 90)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
