---
import { href } from '~/lib/url';
import { site } from '~/site.config';

// 后台入口用 Astro 路由，配置文件仍由 public/admin/config.yml 提供。
// 预览根地址跟随本次构建的 site/base，本地开发则指向当前开发服务器。
const siteRoot = new URL(
  href('/'),
  import.meta.env.DEV ? Astro.url : (Astro.site ?? Astro.url),
).href;
const appTitle = `${site.title} · 内容工作台`;
const cmsScriptUrl = 'https://unpkg.com/@sveltia/cms@0.265.2/dist/sveltia-cms.js';
const cmsScriptIntegrity = 'sha256-GuQH7PO73MpnWIBlcZr96FRthbW6Ej+DCRwp5za0fUY=';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#268358" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="cms-config-url" href={href('/admin/config.yml')} type="application/yaml" />
    <title>{appTitle}</title>
  </head>
  <body
    data-pagefind-ignore
    data-site-url={siteRoot}
    data-app-title={appTitle}
    data-logo-url={href('/brand-icon.png')}
    data-cms-script-url={cmsScriptUrl}
    data-cms-script-integrity={cmsScriptIntegrity}
  >
    <header class="admin-brand">
      <a href={href('/')} class="admin-brand-link" aria-label="返回博客首页">
        <img src={href('/icon-64.png')} alt="" width="32" height="32" />
        <span>
          <strong>{site.shortTitle}</strong>
          <small>内容工作台</small>
        </span>
      </a>
      <nav class="admin-actions" aria-label="后台帮助">
        <details class="admin-help">
          <summary>登录与恢复</summary>
          <div class="admin-help-panel">
            <strong>最快的办法：不用令牌</strong>
            <p class="admin-help-alt">
              打开 <a href="https://github.dev/fa1nes/blog" target="_blank" rel="noopener noreferrer"
                >github.dev/fa1nes/blog</a
              >：浏览器里直接变成 VS Code，用 GitHub 账号登录就能改文章、传图片、提交，走同一条部署流水线。
            </p>

            <strong>使用 GitHub 令牌登录</strong>
            <ol>
              <li>使用拥有当前博客仓库写入权限的 GitHub 账号，在后台选择“以令牌登录”。</li>
              <li>
                创建 <a
                  href="https://github.com/settings/personal-access-tokens/new"
                  target="_blank"
                  rel="noopener noreferrer">fine-grained PAT</a
                >，仅授予当前博客仓库访问权限，并设置过期时间。
              </li>
              <li>
                仓库权限只需 <code>Contents: Read and write</code>；<code>Metadata: Read</code>
                由 GitHub 自动附带。当前直接提交工作流无需 Pull requests 或 Workflows 权限。
              </li>
              <li>将令牌粘贴到 CMS 登录框。请只在可信设备登录，使用共享设备后退出后台。</li>
            </ol>
            <p>
              保存会直接提交到发布分支并触发部署。若分支保护禁止直接提交，需要先允许该账号写入。
              登录失败时请检查令牌有效期、仓库授权和 GitHub 服务状态。
            </p>
            <p>
              页面或配置加载异常时，先保留尚未提交的正文，再 <a href={href('/admin/')}
                >重新打开后台</a
              >。
            </p>
          </div>
        </details>
        <a href={href('/')} class="admin-site-link">查看博客</a>
      </nav>
    </header>

    <main class="admin-loading" role="status" aria-live="polite" aria-atomic="true">
      <span class="admin-spinner" aria-hidden="true"></span>
      <div>
        <strong data-admin-heading>正在打开内容工作台</strong>
        <p data-admin-message>加载文章、动态、友链与页面管理功能…</p>
        <button class="admin-retry" type="button" hidden>重新加载</button>
      </div>
    </main>
    <div id="nc-root" hidden></div>

    <noscript>
      <style is:inline>.admin-loading { display: none; }</style>
      <main class="admin-fallback">
        <h1>需要启用 JavaScript</h1>
        <p>内容管理后台依赖 JavaScript 才能加载，请启用后刷新页面。</p>
        <a href={href('/')}>返回博客首页</a>
      </main>
    </noscript>

    <style is:inline>
      :root {
        color-scheme: light dark;
        font-family:
          system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Microsoft YaHei', sans-serif;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f8fafc;
        color: #35434f;
      }

      .admin-brand {
        position: relative;
        z-index: 10;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
        gap: 0.75rem;
        padding: 0.75rem clamp(0.75rem, 4vw, 2rem);
        border-bottom: 1px solid #dde3ea;
        background: #fff;
      }

      .admin-brand-link,
      .admin-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .admin-brand-link {
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .admin-brand-link span { display: flex; flex-direction: column; }
      .admin-brand-link strong { color: #35434f; font-size: 0.95rem; }
      .admin-brand-link small { color: #6b7885; font-size: 0.75rem; }
      .admin-actions { flex-shrink: 0; font-size: 0.82rem; }

      .admin-site-link,
      .admin-retry {
        padding: 0.45rem 0.85rem;
        border: 0;
        border-radius: 9999px;
        background: #eafaf2;
        color: #1e7049;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      .admin-help summary { cursor: pointer; }

      .admin-help-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0.75rem;
        box-sizing: border-box;
        width: min(26rem, calc(100vw - 1.5rem));
        max-height: calc(100dvh - 5.5rem);
        overflow: auto;
        padding: 1.25rem;
        border: 1px solid #dde3ea;
        border-radius: 1rem;
        background: #fff;
        color: #35434f;
        box-shadow: 0 12px 36px rgb(0 0 0 / 12%);
        line-height: 1.7;
      }

      .admin-help-panel ol { padding-left: 1.4rem; }
      .admin-help-panel li + li { margin-top: 0.5rem; }
      .admin-help-panel p { margin-bottom: 0; }
      .admin-help-panel strong { display: block; margin-bottom: 0.35rem; }
      .admin-help-panel strong + ol,
      .admin-help-panel strong + p { margin-top: 0; }
      .admin-help-panel p + strong { margin-top: 0.9rem; }
      .admin-help-alt { margin: 0 0 1rem; }
      .admin-help-panel code { overflow-wrap: anywhere; }
      .admin-help-panel a,
      .admin-fallback a { color: #1e7049; text-underline-offset: 0.2em; }

      .admin-loading {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        min-height: calc(100vh - 4rem);
        padding: 2rem;
      }

      .admin-loading strong { display: block; }
      .admin-loading p {
        max-width: 32rem;
        margin: 0.5rem 0 0;
        color: #50616d;
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .admin-retry { margin-top: 1rem; }
      .admin-spinner {
        flex-shrink: 0;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid #dde3ea;
        border-top-color: #268358;
        border-radius: 9999px;
        animation: admin-spin 0.75s linear infinite;
      }

      #nc-root {
        position: fixed;
        inset: 4rem 0 0;
        /* CMS 编辑器使用 fixed 定位，将其包含在导航下方，避免保存按钮被遮挡。 */
        transform: translateZ(0);
      }
      #nc-root[hidden],
      .admin-loading[hidden],
      .admin-spinner[hidden],
      .admin-retry[hidden] { display: none; }

      .admin-fallback {
        box-sizing: border-box;
        width: min(100% - 2rem, 32rem);
        margin: 15vh auto 0;
        padding: 2rem;
        border: 1px solid #dde3ea;
        border-radius: 1rem;
        background: #fff;
      }
      .admin-fallback h1 { margin: 0; font-size: 1.4rem; }
      .admin-fallback p { line-height: 1.7; }
      @keyframes admin-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        .admin-spinner { animation: none; }
      }
      @media (max-width: 380px) {
        .admin-brand-link small { display: none; }
        .admin-actions { gap: 0.5rem; }
        .admin-site-link { padding-inline: 0.6rem; }
      }
      @media (prefers-color-scheme: dark) {
        body { background: #1a202c; color: #f3f7fb; }
        .admin-brand,
        .admin-help-panel,
        .admin-fallback { border-color: #3f4c5f; background: #232b38; color: #f3f7fb; }
        .admin-brand-link strong { color: #f3f7fb; }
        .admin-brand-link small,
        .admin-loading p { color: #a0aec0; }
        .admin-help-panel a,
        .admin-fallback a { color: #68d391; }
      }
    </style>

    <script is:inline>
      // Sveltia CMS 用到了一批较新的 Web API（Promise.withResolvers / Object.groupBy /
      // URL.canParse 等）。iOS 17.4 以下的 Safari、部分国产浏览器内核还没有这些，
      // CMS.init() 会直接抛错，页面就停在「后台初始化失败」。这里做最小垫片。
      (() => {
        const define = (target, key, value) => {
          try {
            if (!(key in target)) {
              Object.defineProperty(target, key, { value, writable: true, configurable: true });
            }
          } catch {
            /* 只读环境忽略 */
          }
        };

        define(Promise, 'withResolvers', function withResolvers() {
          let resolve;
          let reject;
          const promise = new Promise((res, rej) => {
            resolve = res;
            reject = rej;
          });
          return { promise, resolve, reject };
        });

        const groupBy = (toMap) => function group(items, callback) {
          const out = toMap ? new Map() : {};
          let index = 0;
          for (const item of items) {
            const key = callback(item, index++);
            if (toMap) {
              if (!out.has(key)) out.set(key, []);
              out.get(key).push(item);
            } else {
              (out[key] = out[key] || []).push(item);
            }
          }
          return out;
        };
        define(Object, 'groupBy', groupBy(false));
        define(Map, 'groupBy', groupBy(true));

        define(Object, 'hasOwn', function hasOwn(object, key) {
          return Object.prototype.hasOwnProperty.call(object, key);
        });

        define(URL, 'canParse', function canParse(url, base) {
          try {
            new URL(url, base);
            return true;
          } catch {
            return false;
          }
        });

        define(AbortSignal, 'timeout', function timeout(ms) {
          const controller = new AbortController();
          setTimeout(() => controller.abort(new DOMException('TimeoutError', 'TimeoutError')), ms);
          return controller.signal;
        });

        define(Array.prototype, 'toSorted', function toSorted(compare) {
          return [...this].sort(compare);
        });
        define(Array.prototype, 'toReversed', function toReversed() {
          return [...this].reverse();
        });
        define(Array.prototype, 'findLast', function findLast(callback) {
          for (let i = this.length - 1; i >= 0; i -= 1) if (callback(this[i], i, this)) return this[i];
          return undefined;
        });
        define(Array.prototype, 'findLastIndex', function findLastIndex(callback) {
          for (let i = this.length - 1; i >= 0; i -= 1) if (callback(this[i], i, this)) return i;
          return -1;
        });

        if (typeof structuredClone !== 'function') {
          window.structuredClone = (value) => JSON.parse(JSON.stringify(value));
        }
        if (window.crypto && typeof window.crypto.randomUUID !== 'function') {
          define(window.crypto, 'randomUUID', () =>
            '10000000-1000-4000-8000-100000000000'.replace(/[018]/g, (c) =>
              (c ^ (Math.random() * 16) >> (c / 4)).toString(16),
            ),
          );
        }
      })();
    </script>

    <script>
      type CmsWindow = Window & {
        CMS_MANUAL_INIT?: boolean;
        CMS?: {
          init: (options: {
            config: {
              site_url: string;
              display_url: string;
              app_title: string;
              logo: { src: string };
            };
          }) => Promise<void>;
        };
      };

      const cmsWindow = window as CmsWindow;
      const root = document.querySelector<HTMLDivElement>('#nc-root');
      const loading = document.querySelector<HTMLElement>('.admin-loading');
      const heading = document.querySelector<HTMLElement>('[data-admin-heading]');
      const message = document.querySelector<HTMLElement>('[data-admin-message]');
      const spinner = document.querySelector<HTMLElement>('.admin-spinner');
      const retry = document.querySelector<HTMLButtonElement>('.admin-retry');

      const withTimeout = async (operation: Promise<void>) => {
        let timer: number | undefined;
        try {
          await Promise.race([
            operation,
            new Promise<never>((_resolve, reject) => {
              timer = window.setTimeout(() => reject(new Error('CMS startup timeout')), 30_000);
            }),
          ]);
        } finally {
          window.clearTimeout(timer);
        }
      };

      retry?.addEventListener('click', () => window.location.reload());

      const startCms = async () => {
        if (!root || !loading || !heading || !message || !spinner || !retry) return;

        // CDN 脚本默认自动初始化；手动挂载才能等待失败并传入本次构建的站点地址。
        cmsWindow.CMS_MANUAL_INIT = true;
        const script = document.createElement('script');
        script.src = document.body.dataset.cmsScriptUrl ?? '';
        script.integrity = document.body.dataset.cmsScriptIntegrity ?? '';
        script.crossOrigin = 'anonymous';
        let stage: 'load' | 'init' = 'load';

        try {
          await withTimeout(new Promise<void>((resolve, reject) => {
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('CMS script unavailable'));
            document.head.append(script);
          }));

          stage = 'init';
          if (typeof cmsWindow.CMS?.init !== 'function') throw new Error('CMS API unavailable');
          await withTimeout(cmsWindow.CMS.init({
            config: {
              site_url: document.body.dataset.siteUrl ?? '',
              display_url: document.body.dataset.siteUrl ?? '',
              app_title: document.body.dataset.appTitle ?? '',
              logo: { src: document.body.dataset.logoUrl ?? '' },
            },
          }));

          // init 只承诺应用已挂载；后续配置与登录错误由 CMS 展示，顶部保留恢复入口。
          loading.hidden = true;
          root.hidden = false;
        } catch (error) {
          script.remove();
          root.hidden = true;
          spinner.hidden = true;
          heading.textContent = '内容工作台未能启动';
          // 把真实的失败原因带出来，遇到浏览器兼容问题时不用猜
          const detail = error instanceof Error && error.message ? `：${error.message}` : '';
          message.textContent = stage === 'load'
            ? `后台资源未能加载${detail}。可能是网络连接或资源校验失败，请检查网络后重新加载，也可从右上角查看登录与恢复说明。`
            : `后台初始化失败${detail}。请重新加载；若仍停在同样位置，可换用桌面版 Chrome / Edge 打开，或直接编辑仓库里的 Markdown。`;
          loading.setAttribute('role', 'alert');
          retry.hidden = false;
          // CMS.init 每页只执行一次，重试必须重载页面，不能再次调用 init。
        } finally {
          script.onload = null;
          script.onerror = null;
        }
      };

      void startCms();
    </script>
  </body>
</html>
