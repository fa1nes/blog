---
import { href } from '~/lib/url';
import { site } from '~/site.config';

// 后台入口用 Astro 路由，配置文件仍由 public/admin/config.yml 提供。
// 预览根地址跟随本次构建的 site/base，本地开发则指向当前开发服务器。
const siteRoot = new URL(
  href('/'),
  import.meta.env.DEV ? Astro.url : (Astro.site ?? Astro.url),
).href;
const appTitle = `${site.title} · 内容工作台`;
// CMS 脚本由 scripts/fetch-cms.mjs 在构建时下载到 public/admin/vendor/，
// 同源加载：没有跨域、没有 SRI 失败，国内网络也不用等 unpkg。
const cmsScriptUrl = href('/admin/vendor/sveltia-cms.js');
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#268358" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="cms-config-url" href={href('/admin/config.yml')} type="application/yaml" />
    <title>{appTitle}</title>
  </head>
  <body
    data-pagefind-ignore
    data-site-url={siteRoot}
    data-app-title={appTitle}
    data-logo-url={href('/brand-icon.png')}
    data-cms-script-url={cmsScriptUrl}
  >
    <header class="admin-brand">
      <a href={href('/')} class="admin-brand-link" aria-label="返回博客首页">
        <img src={href('/icon-64.png')} alt="" width="32" height="32" />
        <span>
          <strong>{site.shortTitle}</strong>
          <small>内容工作台</small>
        </span>
      </a>
      <nav class="admin-actions" aria-label="后台帮助">
        <details class="admin-help">
          <summary>登录与恢复</summary>
          <div class="admin-help-panel">
            <strong>浏览器太老打不开？</strong>
            <p class="admin-help-alt">
              用 <a href={href('/admin/lite/')}>极简后台</a>：只有一个 Markdown 输入框，
              iOS 12、Android 5、微信内置浏览器都能跑。
            </p>

            <strong>最快的办法：不用令牌</strong>
            <p class="admin-help-alt">
              打开 <a href="https://github.dev/fa1nes/blog" target="_blank" rel="noopener noreferrer"
                >github.dev/fa1nes/blog</a
              >：浏览器里直接变成 VS Code，用 GitHub 账号登录就能改文章、传图片、提交，走同一条部署流水线。
            </p>

            <strong>使用 GitHub 令牌登录</strong>
            <ol>
              <li>使用拥有当前博客仓库写入权限的 GitHub 账号，在后台选择“以令牌登录”。</li>
              <li>
                创建 <a
                  href="https://github.com/settings/personal-access-tokens/new"
                  target="_blank"
                  rel="noopener noreferrer">fine-grained PAT</a
                >，仅授予当前博客仓库访问权限，并设置过期时间。
              </li>
              <li>
                仓库权限只需 <code>Contents: Read and write</code>；<code>Metadata: Read</code>
                由 GitHub 自动附带。当前直接提交工作流无需 Pull requests 或 Workflows 权限。
              </li>
              <li>将令牌粘贴到 CMS 登录框。请只在可信设备登录，使用共享设备后退出后台。</li>
            </ol>
            <p>
              保存会直接提交到发布分支并触发部署。若分支保护禁止直接提交，需要先允许该账号写入。
              登录失败时请检查令牌有效期、仓库授权和 GitHub 服务状态。
            </p>
            <p>
              页面或配置加载异常时，先保留尚未提交的正文，再 <a href={href('/admin/')}
                >重新打开后台</a
              >。
            </p>
          </div>
        </details>
        <a href={href('/')} class="admin-site-link">查看博客</a>
      </nav>
    </header>

    <main class="admin-loading" role="status" aria-live="polite" aria-atomic="true">
      <span class="admin-spinner" aria-hidden="true"></span>
      <div>
        <strong data-admin-heading>正在打开内容工作台</strong>
        <p data-admin-message>加载文章、动态、友链与页面管理功能…</p>
        <button class="admin-retry" type="button" hidden>重新加载</button>
      </div>
    </main>

    <!-- 浏览器太老（iOS < 16.4）时的兜底：完整后台的脚本里有正则 lookbehind，
         那是语法级特性，垫片解决不了，只能换一个极简编辑器。 -->
    <main class="admin-legacy" id="legacy-fallback" hidden>
      <h1>这台设备的浏览器版本偏老</h1>
      <p>
        完整后台用到了正则 lookbehind 等较新的语法，iOS / iPadOS 16.4（Safari 16.4）以下无法解析，
        垫片也补不了。可以改用极简后台：只有一个输入框，改 Markdown 后保存，同样会提交到仓库并触发部署。
      </p>
      <p class="admin-legacy-actions">
        <a class="admin-legacy-primary" href={href('/admin/lite/')}>进入极简后台</a>
        <button class="admin-legacy-secondary" type="button" id="force-full">仍然试试完整后台</button>
      </p>
      <p class="admin-legacy-note">
        极简后台需要粘贴一个 GitHub 令牌（只读改这一个仓库），首次填一次即可。也可以直接改仓库里的文件。
      </p>
    </main>
    <div id="nc-root" hidden></div>

    <noscript>
      <style is:inline>.admin-loading { display: none; }</style>
      <main class="admin-fallback">
        <h1>需要启用 JavaScript</h1>
        <p>内容管理后台依赖 JavaScript 才能加载，请启用后刷新页面。</p>
        <a href={href('/')}>返回博客首页</a>
      </main>
    </noscript>

    <style is:inline>
      :root {
        color-scheme: light dark;
        font-family:
          system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Microsoft YaHei', sans-serif;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f8fafc;
        color: #35434f;
      }

      .admin-brand {
        position: relative;
        z-index: 10;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
        gap: 0.75rem;
        padding: 0.75rem clamp(0.75rem, 4vw, 2rem);
        border-bottom: 1px solid #dde3ea;
        background: #fff;
      }

      .admin-brand-link,
      .admin-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .admin-brand-link {
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .admin-brand-link span { display: flex; flex-direction: column; }
      .admin-brand-link strong { color: #35434f; font-size: 0.95rem; }
      .admin-brand-link small { color: #6b7885; font-size: 0.75rem; }
      .admin-actions { flex-shrink: 0; font-size: 0.82rem; }

      .admin-site-link,
      .admin-retry {
        padding: 0.45rem 0.85rem;
        border: 0;
        border-radius: 9999px;
        background: #eafaf2;
        color: #1e7049;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      .admin-help summary { cursor: pointer; }

      .admin-help-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0.75rem;
        box-sizing: border-box;
        width: min(26rem, calc(100vw - 1.5rem));
        max-height: calc(100dvh - 5.5rem);
        overflow: auto;
        padding: 1.25rem;
        border: 1px solid #dde3ea;
        border-radius: 1rem;
        background: #fff;
        color: #35434f;
        box-shadow: 0 12px 36px rgb(0 0 0 / 12%);
        line-height: 1.7;
      }

      .admin-help-panel ol { padding-left: 1.4rem; }
      .admin-help-panel li + li { margin-top: 0.5rem; }
      .admin-help-panel p { margin-bottom: 0; }
      .admin-help-panel strong { display: block; margin-bottom: 0.35rem; }
      .admin-help-panel strong + ol,
      .admin-help-panel strong + p { margin-top: 0; }
      .admin-help-panel p + strong { margin-top: 0.9rem; }
      .admin-help-alt { margin: 0 0 1rem; }
      .admin-help-panel code { overflow-wrap: anywhere; }
      .admin-help-panel a,
      .admin-fallback a { color: #1e7049; text-underline-offset: 0.2em; }

      .admin-loading {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        min-height: calc(100vh - 4rem);
        padding: 2rem;
      }

      .admin-loading strong { display: block; }
      .admin-loading p {
        max-width: 32rem;
        margin: 0.5rem 0 0;
        color: #50616d;
        font-size: 0.9rem;
        line-height: 1.7;
      }

      .admin-retry { margin-top: 1rem; }
      .admin-spinner {
        flex-shrink: 0;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid #dde3ea;
        border-top-color: #268358;
        border-radius: 9999px;
        animation: admin-spin 0.75s linear infinite;
      }

      #nc-root {
        position: fixed;
        inset: 4rem 0 0;
        /* CMS 编辑器使用 fixed 定位，将其包含在导航下方，避免保存按钮被遮挡。 */
        transform: translateZ(0);
      }
      #nc-root[hidden],
      .admin-loading[hidden],
      .admin-spinner[hidden],
      .admin-retry[hidden] { display: none; }

      .admin-fallback {
        box-sizing: border-box;
        width: min(100% - 2rem, 32rem);
        margin: 15vh auto 0;
        padding: 2rem;
        border: 1px solid #dde3ea;
        border-radius: 1rem;
        background: #fff;
      }
      .admin-fallback h1 { margin: 0; font-size: 1.4rem; }
      .admin-fallback p { line-height: 1.7; }

      .admin-legacy {
        box-sizing: border-box;
        width: min(100% - 2rem, 34rem);
        margin: 8vh auto 0;
        padding: 1.75rem;
        border: 1px solid #dde3ea;
        border-radius: 1rem;
        background: #fff;
        line-height: 1.75;
      }
      .admin-legacy h1 { margin: 0 0 0.75rem; font-size: 1.35rem; }
      .admin-legacy p { margin: 0 0 1rem; color: #4a5a66; }
      .admin-legacy-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
      }
      .admin-legacy-primary,
      .admin-legacy-secondary {
        display: inline-block;
        padding: 0.7rem 1.2rem;
        border: 0;
        border-radius: 9999px;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }
      .admin-legacy-primary { background: #268358; color: #fff; }
      .admin-legacy-secondary { background: #eef2f5; color: #35434f; }
      .admin-legacy-note { margin: 1rem 0 0; font-size: 0.85rem; color: #6b7885; }
      @keyframes admin-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        .admin-spinner { animation: none; }
      }
      @media (max-width: 380px) {
        .admin-brand-link small { display: none; }
        .admin-actions { gap: 0.5rem; }
        .admin-site-link { padding-inline: 0.6rem; }
      }
      @media (prefers-color-scheme: dark) {
        body { background: #1a202c; color: #f3f7fb; }
        .admin-brand,
        .admin-help-panel,
        .admin-fallback { border-color: #3f4c5f; background: #232b38; color: #f3f7fb; }
        .admin-brand-link strong { color: #f3f7fb; }
        .admin-brand-link small,
        .admin-loading p { color: #a0aec0; }
        .admin-help-panel a,
        .admin-fallback a { color: #68d391; }
      }
    </style>

    <script is:inline>
      // Sveltia CMS 用了一批较新的 Web API。iOS/iPadOS 16 的 Safari、部分国产浏览器
      // 内核（X5、UC）都缺其中几个，CMS.init() 会直接抛错，页面停在「初始化失败」。
      // 这里补到 iOS 16.0 可用：缺什么补什么，已有的不覆盖。
      (() => {
        const define = (target, key, value) => {
          try {
            if (!(key in target)) {
              Object.defineProperty(target, key, { value, writable: true, configurable: true });
            }
          } catch {
            /* 只读环境忽略 */
          }
        };

        /* ---------- Promise / Object ---------- */

        define(Promise, 'withResolvers', function withResolvers() {
          let resolve;
          let reject;
          const promise = new Promise((res, rej) => {
            resolve = res;
            reject = rej;
          });
          return { promise, resolve, reject };
        });

        define(Promise, 'try', function promiseTry(callback) {
          return new Promise((resolve) => resolve(callback()));
        });

        const groupBy = (toMap) => function group(items, callback) {
          const out = toMap ? new Map() : {};
          let index = 0;
          for (const item of items) {
            const key = callback(item, index++);
            if (toMap) {
              if (!out.has(key)) out.set(key, []);
              out.get(key).push(item);
            } else {
              (out[key] = out[key] || []).push(item);
            }
          }
          return out;
        };
        define(Object, 'groupBy', groupBy(false));
        define(Map, 'groupBy', groupBy(true));

        define(Object, 'hasOwn', function hasOwn(object, key) {
          return Object.prototype.hasOwnProperty.call(object, key);
        });

        /* ---------- URL / AbortSignal ---------- */

        define(URL, 'canParse', function canParse(url, base) {
          try {
            new URL(url, base);
            return true;
          } catch {
            return false;
          }
        });

        define(URL, 'parse', function parse(url, base) {
          try {
            return new URL(url, base);
          } catch {
            return null;
          }
        });

        define(AbortSignal, 'timeout', function timeout(ms) {
          const controller = new AbortController();
          setTimeout(() => controller.abort(new DOMException('TimeoutError', 'TimeoutError')), ms);
          return controller.signal;
        });

        define(AbortSignal, 'any', function any(signals) {
          const controller = new AbortController();
          for (const signal of signals) {
            if (signal.aborted) {
              controller.abort(signal.reason);
              break;
            }
            signal.addEventListener('abort', () => controller.abort(signal.reason), { once: true });
          }
          return controller.signal;
        });

        /* ---------- Array ---------- */

        define(Array.prototype, 'at', function at(index) {
          const i = Math.trunc(index) || 0;
          return this[i < 0 ? this.length + i : i];
        });
        define(Array.prototype, 'toSorted', function toSorted(compare) {
          return [...this].sort(compare);
        });
        define(Array.prototype, 'toReversed', function toReversed() {
          return [...this].reverse();
        });
        define(Array.prototype, 'toSpliced', function toSpliced(start, deleteCount, ...items) {
          const copy = [...this];
          copy.splice(start, deleteCount, ...items);
          return copy;
        });
        define(Array.prototype, 'with', function with_(index, value) {
          const copy = [...this];
          const i = Math.trunc(index) || 0;
          copy[i < 0 ? copy.length + i : i] = value;
          return copy;
        });
        define(Array.prototype, 'findLast', function findLast(callback) {
          for (let i = this.length - 1; i >= 0; i -= 1) if (callback(this[i], i, this)) return this[i];
          return undefined;
        });
        define(Array.prototype, 'findLastIndex', function findLastIndex(callback) {
          for (let i = this.length - 1; i >= 0; i -= 1) if (callback(this[i], i, this)) return i;
          return -1;
        });
        define(Array, 'fromAsync', async function fromAsync(items, mapFn) {
          const out = [];
          for await (const item of items) out.push(mapFn ? await mapFn(item, out.length) : item);
          return out;
        });

        /* ---------- Set ---------- */

        const setLike = (value) => new Set(value ?? []);
        define(Set.prototype, 'union', function union(other) {
          const out = new Set(this);
          for (const value of setLike(other)) out.add(value);
          return out;
        });
        define(Set.prototype, 'intersection', function intersection(other) {
          const right = setLike(other);
          const out = new Set();
          for (const value of this) if (right.has(value)) out.add(value);
          return out;
        });
        define(Set.prototype, 'difference', function difference(other) {
          const right = setLike(other);
          const out = new Set();
          for (const value of this) if (!right.has(value)) out.add(value);
          return out;
        });
        define(Set.prototype, 'symmetricDifference', function symmetricDifference(other) {
          const right = setLike(other);
          const out = new Set();
          for (const value of this) if (!right.has(value)) out.add(value);
          for (const value of right) if (!this.has(value)) out.add(value);
          return out;
        });
        define(Set.prototype, 'isSubsetOf', function isSubsetOf(other) {
          for (const value of this) if (!setLike(other).has(value)) return false;
          return true;
        });
        define(Set.prototype, 'isSupersetOf', function isSupersetOf(other) {
          for (const value of setLike(other)) if (!this.has(value)) return false;
          return true;
        });
        define(Set.prototype, 'isDisjointFrom', function isDisjointFrom(other) {
          for (const value of setLike(other)) if (this.has(value)) return false;
          return true;
        });

        /* ---------- String ---------- */

        const isWellFormed = (string) => {
          for (let i = 0; i < string.length; i += 1) {
            const code = string.charCodeAt(i);
            if (code >= 0xd800 && code <= 0xdbff) {
              const next = string.charCodeAt(i + 1);
              if (!(next >= 0xdc00 && next <= 0xdfff)) return false;
              i += 1;
            } else if (code >= 0xdc00 && code <= 0xdfff) {
              return false;
            }
          }
          return true;
        };
        define(String.prototype, 'isWellFormed', function isWellFormed_() {
          return isWellFormed(this);
        });
        define(String.prototype, 'toWellFormed', function toWellFormed() {
          let out = '';
          for (let i = 0; i < this.length; i += 1) {
            const code = this.charCodeAt(i);
            if (code >= 0xd800 && code <= 0xdbff) {
              const next = this.charCodeAt(i + 1);
              out += next >= 0xdc00 && next <= 0xdfff ? this[i] + this[i + 1] : '\uFFFD';
              i += 1;
            } else {
              out += code >= 0xdc00 && code <= 0xdfff ? '\uFFFD' : this[i];
            }
          }
          return out;
        });

        /* ---------- TypedArray 与二进制 ---------- */

        define(Uint8Array.prototype, 'toBase64', function toBase64() {
          let binary = '';
          for (const byte of this) binary += String.fromCharCode(byte);
          return btoa(binary);
        });
        define(Uint8Array, 'fromBase64', function fromBase64(text) {
          const binary = atob(text);
          const out = new Uint8Array(binary.length);
          for (let i = 0; i < binary.length; i += 1) out[i] = binary.charCodeAt(i);
          return out;
        });
        define(Uint8Array.prototype, 'toHex', function toHex() {
          let out = '';
          for (const byte of this) out += byte.toString(16).padStart(2, '0');
          return out;
        });
        define(Uint8Array, 'fromHex', function fromHex(text) {
          const out = new Uint8Array(text.length / 2);
          for (let i = 0; i < out.length; i += 1) out[i] = parseInt(text.slice(i * 2, i * 2 + 2), 16);
          return out;
        });

        /* ---------- 全局工具 ---------- */

        // 不用 JSON 兜底：Sveltia 会克隆含 Map/Set/Date 的状态，JSON 会悄悄改变结构。
        if (typeof structuredClone !== 'function') {
          const clone = (value, seen) => {
            if (value === null || typeof value !== 'object') return value;
            if (seen.has(value)) return seen.get(value);
            if (value instanceof Date) return new Date(value.getTime());
            if (value instanceof RegExp) return new RegExp(value.source, value.flags);
            if (value instanceof Map) {
              const map = new Map();
              seen.set(value, map);
              for (const [key, item] of value) map.set(clone(key, seen), clone(item, seen));
              return map;
            }
            if (value instanceof Set) {
              const set = new Set();
              seen.set(value, set);
              for (const item of value) set.add(clone(item, seen));
              return set;
            }
            if (ArrayBuffer.isView(value)) return value.slice();
            if (Array.isArray(value)) {
              const list = [];
              seen.set(value, list);
              for (const item of value) list.push(clone(item, seen));
              return list;
            }
            const out = Object.create(Object.getPrototypeOf(value));
            seen.set(value, out);
            for (const key of Object.keys(value)) out[key] = clone(value[key], seen);
            return out;
          };
          window.structuredClone = (value) => clone(value, new WeakMap());
        }

        if (window.crypto && typeof window.crypto.randomUUID !== 'function') {
          define(window.crypto, 'randomUUID', () =>
            '10000000-1000-4000-8000-100000000000'.replace(/[018]/g, (c) =>
              (c ^ (Math.random() * 16) >> (c / 4)).toString(16),
            ),
          );
        }

        if (typeof reportError !== 'function') {
          window.reportError = (error) => {
            setTimeout(() => {
              throw error;
            });
          };
        }
      })();
    </script>

    <script>
      type CmsWindow = Window & {
        CMS_MANUAL_INIT?: boolean;
        CMS?: {
          init: (options: {
            config: {
              site_url: string;
              display_url: string;
              app_title: string;
              logo: { src: string };
            };
          }) => Promise<void>;
        };
      };

      const cmsWindow = window as CmsWindow;
      const root = document.querySelector<HTMLDivElement>('#nc-root');
      const loading = document.querySelector<HTMLElement>('.admin-loading');
      const heading = document.querySelector<HTMLElement>('[data-admin-heading]');
      const message = document.querySelector<HTMLElement>('[data-admin-message]');
      const spinner = document.querySelector<HTMLElement>('.admin-spinner');
      const retry = document.querySelector<HTMLButtonElement>('.admin-retry');

      const withTimeout = async (operation: Promise<void>) => {
        let timer: number | undefined;
        try {
          await Promise.race([
            operation,
            new Promise<never>((_resolve, reject) => {
              timer = window.setTimeout(() => reject(new Error('CMS startup timeout')), 30_000);
            }),
          ]);
        } finally {
          window.clearTimeout(timer);
        }
      };

      retry?.addEventListener('click', () => window.location.reload());

      // 完整后台的脚本里有正则 lookbehind（语法级特性），Safari 16.4 / iOS 16.4 以下
      // 连解析都过不去，垫片救不了。检测不到就直接引到极简后台。
      // 这里必须用运行时拼接：写成 new RegExp('(?<=a)b') 会被压缩器折叠成字面量，
      // 字面量在解析期就编译完了，绕过检测。
      const lookbehindProbe = ['(?<', '=a)b'].join('');
      const supportsModernSyntax = (() => {
        try {
          new RegExp(lookbehindProbe);
          return true;
        } catch {
          return false;
        }
      })();

      const legacyPanel = document.querySelector<HTMLElement>('#legacy-fallback');
      const forceFull = new URLSearchParams(window.location.search).has('full');
      const forceFullButton = document.querySelector<HTMLButtonElement>('#force-full');
      forceFullButton?.addEventListener('click', () => {
        window.location.search = '?full=1';
      });

      const startCms = async () => {
        if (!root || !loading || !heading || !message || !spinner || !retry) return;

        if (!supportsModernSyntax && !forceFull) {
          // 老浏览器：直接给极简后台，别让用户对着「初始化失败」发呆
          loading.hidden = true;
          if (legacyPanel) legacyPanel.hidden = false;
          return;
        }

        // CDN 脚本默认自动初始化；手动挂载才能等待失败并传入本次构建的站点地址。
        cmsWindow.CMS_MANUAL_INIT = true;
        const script = document.createElement('script');
        script.src = document.body.dataset.cmsScriptUrl ?? '';
        let stage: 'load' | 'init' = 'load';

        try {
          await withTimeout(new Promise<void>((resolve, reject) => {
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('CMS script unavailable'));
            document.head.append(script);
          }));

          stage = 'init';
          if (typeof cmsWindow.CMS?.init !== 'function') throw new Error('CMS API unavailable');
          await withTimeout(cmsWindow.CMS.init({
            config: {
              site_url: document.body.dataset.siteUrl ?? '',
              display_url: document.body.dataset.siteUrl ?? '',
              app_title: document.body.dataset.appTitle ?? '',
              logo: { src: document.body.dataset.logoUrl ?? '' },
            },
          }));

          // init 只承诺应用已挂载；后续配置与登录错误由 CMS 展示，顶部保留恢复入口。
          loading.hidden = true;
          root.hidden = false;
        } catch (error) {
          script.remove();
          root.hidden = true;
          spinner.hidden = true;
          heading.textContent = '内容工作台未能启动';
          // 把真实的失败原因带出来，遇到浏览器兼容问题时不用猜
          const detail = error instanceof Error && error.message ? `：${error.message}` : '';
          message.textContent = stage === 'load'
            ? `后台资源未能加载${detail}。可能是网络连接或资源校验失败，请检查网络后重新加载，也可从右上角查看登录与恢复说明。`
            : `后台初始化失败${detail}。可以重新加载；若反复停在这里，改用极简后台（/admin/lite/），或直接编辑仓库里的 Markdown。`;
          loading.setAttribute('role', 'alert');
          retry.hidden = false;
          // CMS.init 每页只执行一次，重试必须重载页面，不能再次调用 init。
        } finally {
          script.onload = null;
          script.onerror = null;
        }
      };

      void startCms();
    </script>
  </body>
</html>
