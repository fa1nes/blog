---
import { href } from '~/lib/url';
import { site } from '~/site.config';

// 后台是一个自包含的轻量页面：不加载任何第三方框架，脚本约 20KB。
// 仓库、分支、OAuth 代理地址都从 /admin/config.yml 读取，改配置不用改代码。
const appTitle = `${site.title} · 内容工作台`;
// 绝对的站点根地址，验收脚本会拿它和 canonical 比对
const siteRoot = new URL(href('/'), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#268358" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="cms-config-url" href={href('/admin/config.yml')} type="application/yaml" />
    <title>{appTitle}</title>
  </head>
  <body data-site-url={siteRoot} data-app-title={appTitle}>
    <header class="bar">
      <a class="brand" href={href('/')} aria-label="返回博客首页">
        <img src={href('/icon-64.png')} alt="" width="30" height="30" />
        <span><strong>{site.shortTitle}</strong><small>内容工作台</small></span>
      </a>
      <nav class="bar-actions">
        <button type="button" id="helpBtn" class="ghost small">帮助</button>
        <a class="ghost small" href={href('/')}>查看博客</a>
      </nav>
    </header>

    <div id="toast" class="toast" hidden></div>

    <main class="wrap">
      <section id="loginView" hidden>
        <h1>登录</h1>
        <p class="lede">用 GitHub 账号登录，或粘贴一个访问令牌。</p>
        <p class="row">
          <button type="button" id="oauthBtn" class="primary">使用 GitHub 登录</button>
          <button type="button" id="tokenToggle" class="ghost">用访问令牌</button>
        </p>
        <div id="tokenPanel" hidden>
          <label for="tokenInput">GitHub 令牌（只需 Contents: Read and write）</label>
          <input id="tokenInput" type="password" autocomplete="off" placeholder="github_pat_…" />
          <p class="row"><button type="button" id="tokenBtn" class="primary">用令牌进入</button></p>
          <p class="hint">
            生成地址：<a
              href="https://github.com/settings/personal-access-tokens/new"
              target="_blank"
              rel="noopener">fine-grained PAT</a
            >，只授权内容仓库。令牌只保存在这台设备上。
          </p>
        </div>
      </section>

      <section id="listView" hidden>
        <div class="list-head">
          <div id="tabs" class="tabs" role="tablist"></div>
          <div class="list-actions">
            <button type="button" id="newBtn" class="primary small">新建</button>
            <button type="button" id="reloadBtn" class="ghost small">刷新</button>
            <button type="button" id="logoutBtn" class="ghost small">退出</button>
          </div>
        </div>
        <ul id="list" class="list"></ul>
        <p id="listEmpty" class="empty" hidden></p>
      </section>

      <section id="editView" hidden>
        <div class="edit-head">
          <button type="button" id="backBtn" class="ghost small">← 返回</button>
          <span id="editPath" class="path"></span>
        </div>
        <form id="editForm" class="form"></form>
        <div class="save-row">
          <button type="button" id="saveBtn" class="primary">保存并发布</button>
          <button type="button" id="deleteBtn" class="danger" hidden>删除</button>
        </div>
      </section>
    </main>

    <dialog id="helpDialog" class="help">
      <h2>几点说明</h2>
      <ul>
        <li>保存会直接提交到内容仓库，两个站点大约两分钟后自动更新。</li>
        <li>文章的文件名决定排序与内部标识，网址由「网址编号」决定（本站用递增数字）。</li>
        <li>图片会上传到 <code>public/uploads/</code>，正文里用 <code>/uploads/名字</code> 引用。</li>
        <li>勾上「草稿」不会出现在线上，取消后再保存才发布。</li>
        <li>这个后台没有任何第三方依赖，iOS 12 以上的设备都能用。</li>
      </ul>
      <p class="row">
        <button type="button" id="helpClose" class="primary">知道了</button>
      </p>
    </dialog>

    <style is:inline>
      :root {
        --accent: #268358;
        --accent-weak: #eafaf2;
        --accent-text: #1e7049;
        --ink: #2c3a35;
        --ink-soft: #5d6b64;
        --ink-faint: #86948c;
        --line: #dfe6e2;
        --paper: #f6f8f7;
        --card: #ffffff;
        --danger: #a1332b;
        color-scheme: light dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font: 16px/1.7 -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        -webkit-text-size-adjust: 100%;
      }
      .bar {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        height: 3.5rem;
        padding: 0 clamp(0.75rem, 4vw, 2rem);
        border-bottom: 1px solid var(--line);
        background: var(--card);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }
      .brand img { border-radius: 8px; }
      .brand span { display: flex; flex-direction: column; line-height: 1.25; }
      .brand strong { font-size: 0.95rem; }
      .brand small { color: var(--ink-faint); font-size: 0.75rem; }
      .bar-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
      .bar-actions a { display: inline-flex; align-items: center; text-decoration: none; }

      .wrap { max-width: 44rem; margin: 0 auto; padding: 1.5rem clamp(0.9rem, 4vw, 2rem) 4rem; }
      h1 { font-size: 1.35rem; margin: 0 0 0.35rem; }
      h2 { font-size: 1.05rem; margin: 0 0 0.75rem; }
      .lede { color: var(--ink-soft); font-size: 0.92rem; margin: 0 0 1.1rem; }
      .hint { color: var(--ink-faint); font-size: 0.82rem; margin: 0.35rem 0 0; }
      .hint a { color: var(--accent); }

      button {
        padding: 0.6rem 1.1rem;
        border: 0;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button.small { padding: 0.4rem 0.85rem; font-size: 0.85rem; }
      button.ghost { background: transparent; color: var(--ink-soft); border: 1px solid var(--line); }
      button.danger { background: #fdeceb; color: var(--danger); }
      button:disabled { opacity: 0.55; cursor: default; }
      .row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 0 0 0.4rem; }

      label { display: block; margin: 0.9rem 0 0.35rem; font-size: 0.82rem; color: var(--ink-soft); }
      input[type='text'],
      input[type='date'],
      input[type='password'],
      textarea {
        width: 100%;
        padding: 0.65rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--card);
        color: inherit;
        font: inherit;
        -webkit-appearance: none;
      }
      textarea {
        min-height: 19rem;
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 0.9rem;
        line-height: 1.65;
      }
      textarea.short { min-height: 4.5rem; font-family: inherit; font-size: 0.95rem; }
      .check { display: flex; align-items: center; gap: 0.5rem; margin: 0.9rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
      .check input { width: auto; }
      .grid { display: flex; flex-wrap: wrap; gap: 0 0.8rem; }
      .grid > div { flex: 1 1 12rem; }

      .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .tab {
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--card);
        color: var(--ink-soft);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
      }
      .tab[aria-selected='true'] { background: var(--accent-weak); border-color: var(--accent); color: var(--accent-text); }
      .list-head {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
      }
      .list-actions { display: flex; gap: 0.4rem; }

      .list {
        margin: 0;
        padding: 0;
        list-style: none;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--card);
        overflow: hidden;
      }
      .list li + li { border-top: 1px solid var(--paper); }
      .item {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        padding: 0.85rem 1rem;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font-weight: 400;
        text-align: left;
        cursor: pointer;
      }
      .item:hover { background: var(--paper); }
      .item b { font-weight: 600; word-break: break-all; }
      .item span { flex-shrink: 0; color: var(--ink-faint); font-size: 0.8rem; }
      .empty { padding: 2rem 0; color: var(--ink-faint); text-align: center; }

      .edit-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }
      .path { color: var(--ink-faint); font-size: 0.78rem; word-break: break-all; }
      .form { padding: 0.4rem 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
      .save-row { display: flex; gap: 0.6rem; margin-top: 1rem; }

      .toast {
        position: fixed;
        left: 50%;
        bottom: 1.4rem;
        z-index: 20;
        max-width: calc(100vw - 2rem);
        padding: 0.7rem 1.1rem;
        border-radius: 999px;
        background: #1f2b26;
        color: #fff;
        font-size: 0.88rem;
        transform: translateX(-50%);
        box-shadow: 0 10px 30px rgb(0 0 0 / 20%);
      }
      .toast.bad { background: #7f2019; }

      .help {
        max-width: min(30rem, calc(100vw - 2rem));
        padding: 1.2rem;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--card);
        color: var(--ink);
      }
      .help::backdrop { background: rgb(0 0 0 / 35%); }
      .help ul { margin: 0 0 1rem; padding-left: 1.1rem; color: var(--ink-soft); font-size: 0.9rem; }
      .help li + li { margin-top: 0.4rem; }
      .help code { padding: 0.1em 0.35em; border-radius: 4px; background: var(--paper); }

      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #eef4f0;
          --ink-soft: #a8b6ae;
          --ink-faint: #7d8b84;
          --line: #333f39;
          --paper: #1a201d;
          --card: #222a26;
          --accent-weak: #1e3a2c;
          --accent-text: #7fd6a6;
        }
        button.danger { background: #3a201e; color: #f3a9a2; }
        .toast { background: #0f1512; }
      }
    </style>

    <script is:inline>
      /* 轻量后台：ES5 + XMLHttpRequest，不依赖任何框架与 CDN。
         现代浏览器和老 iPad 共用同一份代码，没有第二套降级页面。 */
      (function () {
        'use strict';

        var CONFIG = {
          repo: 'fa1nes/blog-content',
          branch: 'main',
          authBase: '',
          mediaFolder: 'public/uploads'
        };

        var TOKEN_KEY = 'blog-admin-token';

        var COLLECTIONS = [
          {
            id: 'posts',
            label: '文章',
            dir: 'src/content/posts',
            ext: 'md',
            body: true,
            fields: [
              { key: 'title', label: '标题', type: 'text', required: true },
              { key: 'slug', label: '网址编号', type: 'text', hint: '决定 /posts/编号/，按发布时间递增' },
              { key: 'pubDate', label: '发布日期', type: 'date' },
              { key: 'category', label: '分类', type: 'text' },
              { key: 'tags', label: '标签', type: 'text', hint: '逗号分隔' },
              { key: 'description', label: '摘要', type: 'textarea-short' },
              { key: 'draft', label: '草稿', type: 'bool' },
              { key: 'pinned', label: '置顶', type: 'bool' }
            ]
          },
          {
            id: 'notes',
            label: '动态',
            dir: 'src/content/notes',
            ext: 'md',
            body: true,
            fields: [
              { key: 'pubDate', label: '时间', type: 'text', hint: '2026-07-26 14:30' },
              { key: 'mood', label: '心情', type: 'text' },
              { key: 'tags', label: '标签', type: 'text', hint: '逗号分隔' },
              { key: 'draft', label: '草稿', type: 'bool' }
            ]
          },
          {
            id: 'friends',
            label: '友链',
            dir: 'src/content/friends',
            ext: 'md',
            body: false,
            fields: [
              { key: 'name', label: '站点名', type: 'text', required: true },
              { key: 'href', label: '地址', type: 'text', required: true, hint: 'https:// 开头' },
              { key: 'description', label: '一句话介绍', type: 'text' },
              { key: 'avatar', label: '头像地址', type: 'text' },
              { key: 'order', label: '排序', type: 'text', hint: '数字越小越靠前' }
            ]
          },
          {
            id: 'pages',
            label: '页面',
            dir: 'src/content/pages',
            ext: 'md',
            body: true,
            fields: [
              { key: 'title', label: '标题', type: 'text', required: true },
              { key: 'description', label: '描述', type: 'text' },
              { key: 'updatedDate', label: '更新日期', type: 'date' }
            ]
          }
        ];

        var state = {
          token: '',
          collection: COLLECTIONS[0],
          list: [],
          current: null
        };

        try { state.token = localStorage.getItem(TOKEN_KEY) || ''; } catch (e) { state.token = ''; }

        function $(id) { return document.getElementById(id); }
        var views = { login: $('loginView'), list: $('listView'), edit: $('editView') };

        /* ---------------- 基础 ---------------- */

        function show(name) {
          views.login.hidden = name !== 'login';
          views.list.hidden = name !== 'list';
          views.edit.hidden = name !== 'edit';
          window.scrollTo(0, 0);
        }

        var toastTimer = 0;
        function toast(text, bad) {
          var el = $('toast');
          el.textContent = text;
          el.className = bad ? 'toast bad' : 'toast';
          el.hidden = false;
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(function () { el.hidden = true; }, bad ? 6000 : 2600);
        }

        function b64encode(text) {
          return window.btoa(unescape(encodeURIComponent(text)));
        }
        function b64decode(text) {
          return decodeURIComponent(escape(window.atob(String(text).replace(/\s/g, ''))));
        }

        function safeName(value) {
          return String(value || '')
            .toLowerCase()
            .replace(/\.[^.]+$/, '')
            .replace(/[^a-z0-9-]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .slice(0, 60);
        }

        function dateToday() {
          var d = new Date();
          function pad(n) { return (n < 10 ? '0' : '') + n; }
          return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        }

        /* ---------------- GitHub API ---------------- */

        function api(method, path, body, done) {
          var xhr = new XMLHttpRequest();
          xhr.open(method, 'https://api.github.com' + path, true);
          xhr.setRequestHeader('Accept', 'application/vnd.github+json');
          xhr.setRequestHeader('Authorization', 'Bearer ' + state.token);
          if (body) xhr.setRequestHeader('Content-Type', 'application/json');
          xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            var data = null;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
            if (xhr.status >= 200 && xhr.status < 300) return done(null, data);
            var message = (data && data.message) || ('HTTP ' + xhr.status);
            if (xhr.status === 401) message = '令牌无效或已过期';
            if (xhr.status === 403) message = '这个令牌没有内容仓库的写入权限';
            if (xhr.status === 404) message = '找不到仓库或文件：' + CONFIG.repo;
            if (xhr.status === 409) message = '文件已被别处修改，刷新列表后重试';
            if (xhr.status === 422) message = 'GitHub 拒绝了这次提交（文件名可能重复）';
            done(new Error(message));
          };
          xhr.send(body ? JSON.stringify(body) : null);
        }

        /* ---------------- frontmatter ---------------- */

        function parseFront(text) {
          var lines = String(text).split('\n');
          if (lines[0].replace(/\s+$/, '') !== '---') return { head: [], body: String(text), fields: {} };
          var end = -1;
          for (var i = 1; i < lines.length; i++) {
            if (lines[i].replace(/\s+$/, '') === '---') { end = i; break; }
          }
          if (end === -1) return { head: [], body: String(text), fields: {} };
          var head = lines.slice(1, end);
          var fields = {};
          for (var j = 0; j < head.length; j++) {
            var m = head[j].match(/^([A-Za-z_][\w-]*):\s*(.*)$/);
            if (m) fields[m[1]] = m[2].replace(/\s+$/, '');
          }
          return { head: head, body: lines.slice(end + 1).join('\n').replace(/^\s*\n/, ''), fields: fields };
        }

        function unwrap(value) {
          var v = String(value == null ? '' : value).trim();
          if ((v.charAt(0) === '"' && v.charAt(v.length - 1) === '"') ||
              (v.charAt(0) === "'" && v.charAt(v.length - 1) === "'")) {
            v = v.slice(1, -1);
          }
          return v;
        }

        function formatValue(field, raw) {
          var value = String(raw == null ? '' : raw).trim();
          if (field.type === 'bool') return value === 'true' ? 'true' : 'false';
          if (field.key === 'tags') {
            var parts = value.replace(/^\[|\]$/g, '').split(',');
            var out = [];
            for (var i = 0; i < parts.length; i++) {
              var item = unwrap(parts[i].replace(/^["']|["']$/g, ''));
              if (item) out.push(item);
            }
            return '[' + out.join(', ') + ']';
          }
          if (field.key === 'order' && /^-?\d+$/.test(value)) return value;
          if (value === '') return '';
          return '"' + value.replace(/"/g, '\\"') + '"';
        }

        function mergeHead(head, fields, values) {
          var lines = head.slice();
          for (var i = 0; i < fields.length; i++) {
            var field = fields[i];
            if (!values.hasOwnProperty(field.key)) continue;
            var text = formatValue(field, values[field.key]);
            var index = -1;
            for (var j = 0; j < lines.length; j++) {
              if (lines[j].indexOf(field.key + ':') === 0) { index = j; break; }
            }
            if (text === '') {
              if (index !== -1) lines.splice(index, 1);
              continue;
            }
            if (index === -1) lines.push(field.key + ': ' + text);
            else lines[index] = field.key + ': ' + text;
          }
          return lines;
        }

        function buildFile(head, body) {
          var out = ['---'];
          for (var i = 0; i < head.length; i++) out.push(head[i]);
          out.push('---');
          return out.join('\n') + '\n\n' + String(body || '').replace(/^\s*\n/, '');
        }

        /**
         * 下一个可用的网址编号：文件列表里只有文件名，编号在 frontmatter 里，
         * 所以要逐个取回来看一眼（文章数量级很小，点「新建」时才发生）。
         */
        function suggestNextSlug(done) {
          var files = state.list || [];
          if (!files.length) { done(1); return; }
          var max = 0;
          var pending = files.length;
          for (var i = 0; i < files.length; i++) {
            (function (file) {
              api('GET', '/repos/' + CONFIG.repo + '/contents/' + file.path + '?ref=' + CONFIG.branch, null, function (err, data) {
                if (!err && data && data.content) {
                  var value = parseFront(b64decode(data.content)).fields.slug;
                  var number = parseInt(String(value == null ? '' : value).replace(/["']/g, ''), 10);
                  if (!isNaN(number) && number > max) max = number;
                }
                pending -= 1;
                if (pending === 0) done(max + 1);
              });
            })(files[i]);
          }
        }

        /* ---------------- 登录 ---------------- */

        function remember(token) {
          state.token = token;
          try { localStorage.setItem(TOKEN_KEY, token); } catch (e) { /* 无痕模式忽略 */ }
        }

        function loginWithToken(token) {
          remember(token);
          api('GET', '/user', null, function (err, user) {
            if (err) {
              state.token = '';
              try { localStorage.removeItem(TOKEN_KEY); } catch (e) {}
              toast(err.message, true);
              return;
            }
            toast('已登录：' + user.login);
            loadList();
          });
        }

        function startOauth() {
          if (!CONFIG.authBase) {
            toast('没有配置 OAuth 代理，请用令牌登录', true);
            return;
          }
          var url = CONFIG.authBase.replace(/\/$/, '') + '/auth?provider=github&site_id=' +
            encodeURIComponent(location.hostname) + '&scope=' + encodeURIComponent('repo,user');
          var popup = window.open(url, 'blog-oauth', 'width=760,height=780');
          if (!popup) toast('弹窗被浏览器拦了，请允许弹窗，或改用令牌登录', true);
        }

        window.addEventListener('message', function (event) {
          if (!CONFIG.authBase) return;
          if (event.origin !== CONFIG.authBase.replace(/\/$/, '')) return;
          var data = event.data;
          if (typeof data !== 'string' || data.indexOf('authorization:github:') !== 0) return;
          var status = data.split(':')[2];
          if (status !== 'success') { toast('GitHub 登录失败，请重试', true); return; }
          var payload = {};
          try { payload = JSON.parse(data.slice(('authorization:github:success:').length)); } catch (e) {}
          if (payload.token) loginWithToken(payload.token);
        });

        /* ---------------- 列表 ---------------- */

        function renderTabs() {
          var tabs = $('tabs');
          tabs.innerHTML = '';
          for (var i = 0; i < COLLECTIONS.length; i++) {
            (function (collection) {
              var button = document.createElement('button');
              button.type = 'button';
              button.className = 'tab';
              button.textContent = collection.label;
              button.setAttribute('role', 'tab');
              button.setAttribute('aria-selected', collection.id === state.collection.id ? 'true' : 'false');
              button.onclick = function () {
                state.collection = collection;
                renderTabs();
                loadList();
              };
              tabs.appendChild(button);
            })(COLLECTIONS[i]);
          }
        }

        function loadList() {
          renderTabs();
          show('list');
          var list = $('list');
          list.innerHTML = '<li class="empty">读取中…</li>';
          var empty = $('listEmpty');
          empty.hidden = true;
          api('GET', '/repos/' + CONFIG.repo + '/contents/' + state.collection.dir + '?ref=' + CONFIG.branch, null, function (err, files) {
            if (err) {
              list.innerHTML = '';
              empty.hidden = false;
              empty.textContent = err.message;
              return;
            }
            var items = [];
            for (var i = 0; i < files.length; i++) {
              if (/\.(md|mdx)$/i.test(files[i].name)) items.push(files[i]);
            }
            items.sort(function (a, b) { return a.name < b.name ? 1 : -1; });
            state.list = items;
            renderList(items);
          });
        }

        function renderList(items) {
          var list = $('list');
          var empty = $('listEmpty');
          list.innerHTML = '';
          if (!items.length) {
            empty.hidden = false;
            empty.textContent = '这里还没有内容，点「新建」开始。';
            return;
          }
          empty.hidden = true;
          for (var i = 0; i < items.length; i++) {
            (function (file) {
              var li = document.createElement('li');
              var button = document.createElement('button');
              button.type = 'button';
              button.className = 'item';
              var name = document.createElement('b');
              name.textContent = file.name.replace(/\.(md|mdx)$/i, '');
              var meta = document.createElement('span');
              meta.textContent = (file.size / 1024).toFixed(1) + ' KB';
              button.appendChild(name);
              button.appendChild(meta);
              button.onclick = function () { openFile(file.path); };
              li.appendChild(button);
              list.appendChild(li);
            })(items[i]);
          }
        }

        /* ---------------- 编辑器 ---------------- */

        function fieldNode(field) {
          var wrap = document.createElement('div');
          if (field.type === 'bool') {
            var check = document.createElement('label');
            check.className = 'check';
            var box = document.createElement('input');
            box.type = 'checkbox';
            box.id = 'f_' + field.key;
            check.appendChild(box);
            check.appendChild(document.createTextNode(field.label));
            wrap.appendChild(check);
            return wrap;
          }
          var label = document.createElement('label');
          label.setAttribute('for', 'f_' + field.key);
          label.textContent = field.label;
          wrap.appendChild(label);

          var input;
          if (field.type === 'textarea-short') {
            input = document.createElement('textarea');
            input.className = 'short';
          } else {
            input = document.createElement('input');
            input.type = field.type === 'date' ? 'date' : 'text';
          }
          input.id = 'f_' + field.key;
          wrap.appendChild(input);

          if (field.hint) {
            var hint = document.createElement('p');
            hint.className = 'hint';
            hint.textContent = field.hint;
            wrap.appendChild(hint);
          }
          return wrap;
        }

        function renderForm(collection, values, body, isNew) {
          var form = $('editForm');
          form.innerHTML = '';

          if (isNew) {
            var filenameWrap = document.createElement('div');
            var filenameLabel = document.createElement('label');
            filenameLabel.setAttribute('for', 'f_filename');
            filenameLabel.textContent = '文件名（英文，可留空自动生成）';
            var filenameInput = document.createElement('input');
            filenameInput.type = 'text';
            filenameInput.id = 'f_filename';
            filenameInput.placeholder = 'my-new-post';
            filenameWrap.appendChild(filenameLabel);
            filenameWrap.appendChild(filenameInput);
            form.appendChild(filenameWrap);
          }

          var grid = document.createElement('div');
          grid.className = 'grid';
          for (var i = 0; i < collection.fields.length; i++) {
            grid.appendChild(fieldNode(collection.fields[i]));
          }
          form.appendChild(grid);

          if (collection.body) {
            var bodyLabel = document.createElement('label');
            bodyLabel.setAttribute('for', 'f_body');
            bodyLabel.textContent = '正文（Markdown）';
            form.appendChild(bodyLabel);
            var area = document.createElement('textarea');
            area.id = 'f_body';
            form.appendChild(area);
            area.value = body || '';

            var uploadRow = document.createElement('p');
            uploadRow.className = 'row';
            uploadRow.style.marginTop = '0.7rem';
            var picker = document.createElement('input');
            picker.type = 'file';
            picker.accept = 'image/*';
            picker.id = 'f_image';
            picker.style.display = 'none';
            var uploadBtn = document.createElement('button');
            uploadBtn.type = 'button';
            uploadBtn.className = 'ghost small';
            uploadBtn.textContent = '插入图片';
            uploadBtn.onclick = function () { picker.click(); };
            picker.onchange = function () { uploadImage(picker, area); };
            uploadRow.appendChild(uploadBtn);
            uploadRow.appendChild(picker);
            form.appendChild(uploadRow);
          }

          for (var j = 0; j < collection.fields.length; j++) {
            var field = collection.fields[j];
            var el = $('f_' + field.key);
            if (!el) continue;
            var value = String(values[field.key] == null ? '' : values[field.key]);
            if (field.type === 'bool') {
              el.checked = value === 'true';
            } else if (field.key === 'tags') {
              el.value = unwrap(value.replace(/^\[|\]$/g, ''));
            } else if (field.type === 'date') {
              // 只认 YYYY-MM-DD；写了「2026-07-20 10:30」这种带时间的值，
              // date 输入框会清空，保存时反而把必填的日期删掉
              var raw = unwrap(value);
              if (raw && !/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
                el.type = 'text';
                el.value = raw;
              } else {
                el.value = raw;
              }
            } else {
              el.value = unwrap(value);
            }
          }

          if (isNew) {
            var slugInput = $('f_slug');
            if (slugInput && !slugInput.value) {
              slugInput.value = '…';
              suggestNextSlug(function (next) {
                // 用户如果已经自己填了，就别覆盖
                if (!slugInput.value || slugInput.value === '…') slugInput.value = String(next);
              });
            }
            var dateInput = $('f_pubDate');
            if (dateInput && !dateInput.value) dateInput.value = dateToday();
          }
        }

        function readForm(collection) {
          var values = {};
          for (var i = 0; i < collection.fields.length; i++) {
            var field = collection.fields[i];
            var el = $('f_' + field.key);
            if (!el) continue;
            values[field.key] = field.type === 'bool' ? (el.checked ? 'true' : 'false') : el.value;
          }
          return values;
        }

        function openFile(path) {
          api('GET', '/repos/' + CONFIG.repo + '/contents/' + path + '?ref=' + CONFIG.branch, null, function (err, file) {
            if (err) { toast(err.message, true); return; }
            var parsed = parseFront(b64decode(file.content));
            state.current = { path: path, sha: file.sha, isNew: false, head: parsed.head };
            $('editPath').textContent = path;
            $('deleteBtn').hidden = false;
            renderForm(state.collection, parsed.fields, parsed.body, false);
            show('edit');
          });
        }

        function startNew() {
          state.current = { path: '', sha: '', isNew: true, head: [] };
          $('editPath').textContent = '新内容 · ' + state.collection.label;
          $('deleteBtn').hidden = true;
          renderForm(state.collection, {}, '', true);
          show('edit');
        }

        function save() {
          var collection = state.collection;
          var current = state.current;
          if (!current) return;

          var values = readForm(collection);
          // 编号还是占位符时按空处理，交给「留空即用文件名」的逻辑
          if (values.slug === '…') values.slug = '';
          for (var i = 0; i < collection.fields.length; i++) {
            var field = collection.fields[i];
            if (field.required && !String(values[field.key] || '').trim()) {
              toast('「' + field.label + '」不能为空', true);
              return;
            }
          }

          var text = buildFile(mergeHead(current.head || [], collection.fields, values), ($('f_body') || {}).value || '');

          var path = current.path;
          if (current.isNew) {
            var base = safeName(($('f_filename') || {}).value) || safeName(values.slug) || ('entry-' + new Date().getTime());
            path = collection.dir + '/' + base + '.' + (collection.ext || 'md');
            current.path = path;
          }

          var payload = {
            message: (current.isNew ? '后台：新增 ' : '后台：更新 ') + path,
            content: b64encode(text),
            branch: CONFIG.branch
          };
          if (current.sha) payload.sha = current.sha;

          $('saveBtn').disabled = true;
          api('PUT', '/repos/' + CONFIG.repo + '/contents/' + path, payload, function (err, data) {
            $('saveBtn').disabled = false;
            if (err) { toast('保存失败：' + err.message, true); return; }
            current.sha = data && data.content ? data.content.sha : current.sha;
            current.isNew = false;
            $('deleteBtn').hidden = false;
            $('editPath').textContent = path;
            toast('已保存，两个站点大约两分钟后更新');
            loadList();
          });
        }

        function removeCurrent() {
          var current = state.current;
          if (!current || !current.path) return;
          if (!window.confirm('删除「' + current.path + '」？这一步无法从后台撤销。')) return;
          api('DELETE', '/repos/' + CONFIG.repo + '/contents/' + current.path, {
            message: '后台：删除 ' + current.path,
            sha: current.sha,
            branch: CONFIG.branch
          }, function (err) {
            if (err) { toast('删除失败：' + err.message, true); return; }
            toast('已删除');
            state.current = null;
            loadList();
          });
        }

        // 只接受位图格式。SVG/HTML 一旦放进 public/ 就是同源文件，
        // 直接打开会在本站上下文执行脚本，能读走 localStorage 里的令牌。
        var IMAGE_ALLOWED = /^(\.png|\.jpg|\.jpeg|\.webp|\.gif|\.avif)$/i;

        function uploadImage(picker, area) {
          var file = picker.files && picker.files[0];
          if (!file) return;
          var extMatch = String(file.name).match(/\.[a-z0-9]+$/i);
          var ext = extMatch ? extMatch[0].toLowerCase() : '';
          if (!IMAGE_ALLOWED.test(ext)) {
            toast('只支持 png / jpg / webp / gif / avif，SVG 请先转成位图', true);
            picker.value = '';
            return;
          }
          if (file.type && file.type.indexOf('image/') !== 0) {
            toast('这个文件不是图片', true);
            picker.value = '';
            return;
          }
          if (file.size > 8 * 1024 * 1024) { toast('图片请控制在 8MB 以内', true); return; }
          var reader = new FileReader();
          reader.onload = function () {
            var dataUrl = String(reader.result);
            var base64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
            var fileName = new Date().getTime() + '-' + (safeName(file.name) || 'image') + ext;
            var path = CONFIG.mediaFolder + '/' + fileName;
            toast('上传中…');
            api('PUT', '/repos/' + CONFIG.repo + '/contents/' + path, {
              message: '后台：上传图片 ' + fileName,
              content: base64,
              branch: CONFIG.branch
            }, function (err) {
              if (err) { toast('上传失败：' + err.message, true); return; }
              var markdown = '![](' + CONFIG.mediaFolder.replace(/^public/, '') + '/' + fileName + ')';
              var start = area.selectionStart || area.value.length;
              area.value = area.value.slice(0, start) + markdown + area.value.slice(start);
              toast('图片已插入正文');
              picker.value = '';
            });
          };
          reader.readAsDataURL(file);
        }

        /* ---------------- 配置与启动 ---------------- */

        function loadConfig(done) {
          var link = document.querySelector('link[rel="cms-config-url"]');
          if (!link) { done(); return; }
          var xhr = new XMLHttpRequest();
          xhr.open('GET', link.href, true);
          xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            var text = xhr.responseText || '';
            var repo = text.match(/^\s*repo:\s*(\S+)/m);
            var branch = text.match(/^\s*branch:\s*(\S+)/m);
            var base = text.match(/^\s*base_url:\s*(\S+)/m);
            var media = text.match(/^\s*media_folder:\s*(\S+)/m);
            if (repo) CONFIG.repo = repo[1];
            if (branch) CONFIG.branch = branch[1];
            if (base) CONFIG.authBase = base[1];
            if (media) CONFIG.mediaFolder = media[1];
            done();
          };
          xhr.send(null);
        }

        function bind() {
          $('oauthBtn').onclick = startOauth;
          $('tokenToggle').onclick = function () { $('tokenPanel').hidden = !$('tokenPanel').hidden; };
          $('tokenBtn').onclick = function () {
            var value = $('tokenInput').value.replace(/\s/g, '');
            if (!value) { toast('先填令牌', true); return; }
            loginWithToken(value);
          };
          $('newBtn').onclick = startNew;
          $('reloadBtn').onclick = loadList;
          $('logoutBtn').onclick = function () {
            state.token = '';
            try { localStorage.removeItem(TOKEN_KEY); } catch (e) {}
            show('login');
          };
          $('backBtn').onclick = function () { state.current = null; loadList(); };
          $('saveBtn').onclick = save;
          $('deleteBtn').onclick = removeCurrent;
          $('helpBtn').onclick = function () {
            var dialog = $('helpDialog');
            if (dialog.showModal) dialog.showModal();
            else dialog.setAttribute('open', 'open');
          };
          $('helpClose').onclick = function () {
            var dialog = $('helpDialog');
            if (dialog.close) dialog.close();
            else dialog.removeAttribute('open');
          };
        }

        function start() {
          bind();
          loadConfig(function () {
            if (!state.token) { show('login'); return; }
            api('GET', '/user', null, function (err) {
              if (err) { show('login'); return; }
              loadList();
            });
          });
        }

        start();
      })();
    </script>
  </body>
</html>
