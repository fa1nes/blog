---
import { site } from '~/site.config';
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import FloatDock from '~/components/FloatDock.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="flex min-h-svh flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only rounded-full border border-line bg-paper px-4 py-2 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60]"
    >
      跳到主要内容
    </a>

    <Header />

    <main id="main" class="relative flex-1">
      <slot />
    </main>

    <FloatDock />
    <Footer />
  </body>
</html>
