---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { Post } from '~/lib/posts';
import { postSlug, postSummary } from '~/lib/posts';
import { formatDate, formatISODate, readingTime } from '~/lib/format';
import { categoryPath, href, postPath, tagPath } from '~/lib/url';
import { comments as commentsConfig, features } from '~/site.config';
import { tocHeadings } from '~/lib/toc';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Comments from '~/components/Comments.astro';
import CodeCopy from '~/components/CodeCopy.astro';
import Icon from '~/components/Icon.astro';
import Toc from '~/components/Toc.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
  related?: Post[];
}

const { post, headings, prev, next, related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt } = post.data;

const summary = postSummary(post);
const stats = readingTime(post.body);
const showToc = features.toc && post.data.toc && tocHeadings(headings).length > 1;
const showComments = commentsConfig.enabled && post.data.comments;
---

<BaseLayout
  title={title}
  description={summary}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
>
  {/* 阅读进度条：CSS 滚动驱动动画，不占用任何 JavaScript */}
  <div class="reading-progress" aria-hidden="true"></div>

  <div class="mx-auto max-w-page px-5 sm:px-8 py-10 lg:py-14">
    <article
      data-pagefind-body
      data-pagefind-meta={`date:${formatISODate(pubDate)}`}
      data-pagefind-filter={`分类:${category}`}
    >
      <header class="border-b border-line pb-7">
        <h1
          class="text-[1.8rem] font-bold leading-tight tracking-tight text-accent sm:text-[2.15rem]"
          data-pagefind-meta="title"
        >
          {title}
        </h1>

        {/* 日期、字数这类页面元信息不该进搜索摘要，整块排除掉 */}
        <div class="mt-3 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 meta-text" data-pagefind-ignore>
          <span class="flex items-center gap-1.5">
            <Icon name="calendar" size={13} class="text-ink-faint" />
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          </span>
          <a href={categoryPath(category)} class="flex items-center gap-1.5 transition-colors hover:text-accent">
            <Icon name="folder" size={13} class="text-ink-faint" />
            {category}
          </a>
          {
            features.readingTime && (
              <>
                <span class="flex items-center gap-1.5">
                  <Icon name="edit" size={13} class="text-ink-faint" />
                  {stats.words} 字
                </span>
                <span class="flex items-center gap-1.5">
                  <Icon name="clock" size={13} class="text-ink-faint" />约 {stats.minutes} 分钟
                </span>
              </>
            )
          }
        </div>

        {description && <p class="mt-4 text-[0.98rem] leading-relaxed text-ink-soft">{description}</p>}
      </header>

      {
        cover &&
          (typeof cover === 'string' ? (
            // 后台上传的图片放在 public 下，只能原样引用，用 href 补上 base 前缀
            <img
              src={href(cover)}
              alt={coverAlt ?? title}
              class="mt-8 w-full rounded-xl border border-line"
              loading="eager"
            />
          ) : (
            // 放在 src 下的图片走 Astro 的优化管线：自动生成 WebP 并写入宽高
            <Image
              src={cover}
              alt={coverAlt ?? title}
              widths={[640, 960, 1280]}
              sizes="(min-width: 44rem) 44rem, 100vw"
              class="mt-8 w-full rounded-xl border border-line"
              loading="eager"
            />
          ))
      }

      {
        showToc && (
          <details class="group mt-7 rounded-xl border border-line px-4 py-3 toc:hidden" data-pagefind-ignore>
            <summary class="flex cursor-pointer list-none items-center gap-2 text-[0.9rem] font-medium text-ink-strong [&::-webkit-details-marker]:hidden">
              <Icon name="list" size={16} class="text-ink-faint" />
              目录
              <Icon
                name="chevronRight"
                size={15}
                class="ml-auto text-ink-faint transition-transform group-open:rotate-90"
              />
            </summary>
            <div class="mt-3">
              <Toc headings={headings} />
            </div>
          </details>
        )
      }

      <div class="prose mt-9">
        <slot />
      </div>

      <footer class="mt-12 flex flex-col gap-5 border-t border-line pt-6">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <a href={tagPath(tag)} class="tag-chip">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
        <div class="flex flex-wrap items-center justify-between gap-3 meta-text">
          <span>
            {updatedDate ? `最后更新于 ${formatDate(updatedDate)}` : `发布于 ${formatDate(pubDate)}`}
          </span>
          <a href="#main" class="flex items-center gap-1 transition-colors hover:text-accent">
            <Icon name="arrowUp" size={14} />
            回到顶部
          </a>
        </div>
      </footer>
    </article>

    {
      showToc && (
        <aside class="toc-sidebar" data-pagefind-ignore>
          <p class="mb-2.5 text-[0.7rem] font-medium uppercase tracking-[0.12em] text-ink-faint">
            目录
          </p>
          <Toc headings={headings} />
        </aside>
      )
    }

    <div data-pagefind-ignore>
      {
        features.postNav && (prev || next) && (
          <nav class="mt-14 grid gap-3 border-t border-line pt-8 sm:grid-cols-2" aria-label="文章导航">
            {prev ? (
              <a
                href={postPath(postSlug(prev))}
                class="group flex flex-col gap-1.5 rounded-xl border border-line p-4 transition-colors hover:border-accent/50 hover:bg-paper-raised"
                rel="prev"
              >
                <span class="flex items-center gap-1.5 meta-text">
                  <Icon name="arrowLeft" size={13} />
                  上一篇
                </span>
                <span class="text-[0.95rem] leading-snug transition-colors group-hover:text-accent">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                href={postPath(postSlug(next))}
                class="group flex flex-col gap-1.5 rounded-xl border border-line p-4 text-right transition-colors hover:border-accent/50 hover:bg-paper-raised sm:col-start-2"
                rel="next"
              >
                <span class="flex items-center justify-end gap-1.5 meta-text">
                  下一篇
                  <Icon name="arrowRight" size={13} />
                </span>
                <span class="text-[0.95rem] leading-snug transition-colors group-hover:text-accent">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }

      {
        related.length > 0 && (
          <section class="mt-14 border-t border-line pt-8">
            <h2 class="font-bold text-lg text-ink-strong">相关文章</h2>
            <ul class="mt-3 flex flex-col">
              {related.map((item) => (
                <li>
                  <a
                    href={postPath(postSlug(item))}
                    class="flex items-baseline gap-3 py-2 transition-colors hover:text-accent"
                  >
                    <time datetime={item.data.pubDate.toISOString()} class="shrink-0 meta-text">
                      {formatISODate(item.data.pubDate)}
                    </time>
                    <span class="min-w-0 flex-1 text-[0.95rem]">{item.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {showComments && <Comments />}
    </div>
  </div>

  {features.codeCopy && <CodeCopy />}
</BaseLayout>

<script>
  // GFM 生成的脚注标题是英文的，且只有读屏软件会读到，这里换成中文
  const footnoteLabel = document.getElementById('footnote-label');
  if (footnoteLabel) footnoteLabel.textContent = '脚注';

  // 渐进增强：给标题补一个可点击的锚点。
  // 没有 JS 时标题依然带 id，直接手写 #slug 也能跳转。
  for (const heading of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]')) {
    if (heading.id === 'footnote-label') continue;
    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${heading.id}`;
    anchor.textContent = '#';
    anchor.setAttribute('aria-label', `跳转到「${heading.textContent?.trim() ?? ''}」`);
    heading.prepend(anchor);
  }
</script>
