---
import { site, author, seo } from '~/site.config';
import { href } from '~/lib/url';
import { serializeJsonLd } from '~/lib/json-ld';
import '~/styles/global.css';
// 由 Vite 换成带哈希的最终地址：与 global.css 里 @font-face 引用的是同一个文件，
// 提前 preload 可以省掉一次「下载 CSS → 才发现字体」的往返。
import fontUrl from '~/assets/fonts/nunito-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** 分享图，可以是站内路径或完整外链 */
  image?: string;
  /** article 用于文章页，website 用于其它页面 */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** 文章分类，写进 BlogPosting 的 articleSection */
  category?: string;
  /** 正文字数，用于 BlogPosting 的 wordCount */
  wordCount?: number;
  /** 预计阅读分钟数，用于 BlogPosting 的 timeRequired */
  readingMinutes?: number;
  /** 不希望被搜索引擎收录时置为 true */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  category,
  wordCount,
  readingMinutes,
  noindex = false,
} = Astro.props;

const origin = Astro.site ?? new URL(site.url);
const isHome = Astro.url.pathname === href('/');
const fullTitle = isHome || title === site.title ? site.title : `${title} - ${site.title}`;

const canonical = new URL(Astro.url.pathname, origin).toString();
// CMS 会把未选封面保存为空字符串，与未传入图片一样使用默认分享图。
const imagePath = image?.trim() || seo.ogImage;
const ogImage = new URL(href(imagePath), origin).toString();
const ogImageAlt = imagePath === seo.ogImage ? `${site.title} · ${site.subtitle}` : title;
const rssUrl = href('/rss.xml');
const siteRoot = new URL(href('/'), origin).toString();

const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        keywords: tags.join(', ') || undefined,
        // 分类与字数能让搜索引擎更准确地归类文章，也方便生成摘要卡片
        articleSection: category || undefined,
        wordCount: wordCount || undefined,
        timeRequired: readingMinutes ? `PT${readingMinutes}M` : undefined,
        inLanguage: site.lang,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        author: { '@type': 'Person', name: author.name, url: author.url || undefined },
        publisher: { '@type': 'Person', name: author.name },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.title,
        description: site.description,
        url: siteRoot,
        inLanguage: site.lang,
        author: { '@type': 'Person', name: author.name, url: author.url || undefined },
        // 站内搜索页支持 ?q=，声明出来可以让搜索引擎直接给出结果入口
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${new URL(href('/search/'), origin).toString()}?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      };

// 文章页额外输出面包屑，搜索结果里会显示「首页 › 文章 › 标题」的层级
const breadcrumbs =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: '首页', item: siteRoot },
          {
            '@type': 'ListItem',
            position: 2,
            name: '文章',
            item: new URL(href('/posts/'), origin).toString(),
          },
          { '@type': 'ListItem', position: 3, name: title, item: canonical },
        ],
      }
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author.name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href={href('/favicon.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} sizes="180x180" />
<link rel="alternate" type="application/rss+xml" title={`${site.title} 的 RSS`} href={rssUrl} />
{seo.sitemap && <link rel="sitemap" href={href('/sitemap-index.xml')} />}
<link rel="manifest" href={href('/site.webmanifest')} />
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={fontUrl}
  crossorigin="anonymous"
/>

<meta name="theme-color" content={seo.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={seo.themeColor.dark} media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imagePath === seo.ogImage && <meta property="og:image:type" content="image/png" />}
{imagePath === seo.ogImage && <meta property="og:image:width" content="1200" />}
{imagePath === seo.ogImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={site.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{seo.twitterSite && <meta name="twitter:site" content={seo.twitterSite} />}

<script type="application/ld+json" set:html={serializeJsonLd(structuredData)} is:inline />
{breadcrumbs && <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)} is:inline />}

{/* 在首屏绘制前写入主题，避免深色模式闪白 */}
<script is:inline>
  (() => {
    let stored;
    try { stored = localStorage.getItem('theme'); } catch { /* 存储受限时继续跟随系统 */ }
    const dark = stored === 'dark' ||
      (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', dark);
  })();
</script>
