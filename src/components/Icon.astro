export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 18, class: className, title } = Astro.props;
const icon: IconDefinition = ICONS[name];
const strokeProps = icon.stroke
  ? {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': 1.75,
      'stroke-linecap': 'round' as const,
      'stroke-linejoin': 'round' as const,
    }
  : { fill: 'currentColor' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
  {...strokeProps}
  set:html={(title ? `<title>${title}</title>` : '') + icon.body}
/>
