---
import { comments, site } from '~/site.config';
import { commentsReady, commentsRepository } from '~/lib/comments';

interface Props {
  title?: string;
  /** 页面自身已有标题时（例如留言板）传 false，避免出现两个相近的小标题 */
  heading?: boolean;
}

const { title = '页面反馈', heading = true } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const giscus = comments.giscus;
---

{/* 总开关：关闭时连标题和 GitHub 入口都不渲染，页面干干净净 */}
{comments.enabled && (
<section class="mt-14 border-t border-line pt-9" data-pagefind-ignore>
  {heading && <h2 class="mb-6 font-bold text-lg text-ink-strong">评论与反馈</h2>}
  {
    commentsReady && (
      <div
        data-giscus-root
        data-repo={commentsRepository}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscus.mapping}
        data-reactions-enabled={giscus.reactionsEnabled ? '1' : '0'}
        data-input-position={giscus.inputPosition}
        data-lang={giscus.lang}
        data-lazy={giscus.lazy ? 'true' : 'false'}
      >
        <p class="meta-text" data-giscus-status role="status" aria-live="polite">
          正在加载在线评论…
        </p>
        <button
          class="mt-3 rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-accent hover:text-accent"
          type="button"
          data-giscus-retry
          hidden
        >
          重新加载评论
        </button>
        <div id="giscus-container" class="giscus min-h-[8rem]" data-giscus-mount />
      </div>
    )
  }

  {
    /* 评论区接通后 GitHub 入口先藏起来；giscus 报错时（比如应用没装）再露出来，
       这样访客看到的是一个能用的入口，而不是一个报错的 iframe。 */
    !commentsReady && (
      <p class="meta-text">留言入口暂时不可用，感谢你的阅读与支持。</p>
    )
  }

  {
    /* 评论接管成功前的备用提示：默认隐藏，只在 giscus 失败时揭开 */
    commentsReady && (
      <p class="meta-text" data-giscus-fallback hidden>
        在线评论没能加载出来，刷新一次或稍后再试。
      </p>
    )
  }
</section>
)}

<script>
  const container = document.querySelector<HTMLElement>('[data-giscus-root]');
  const mount = container?.querySelector<HTMLElement>('[data-giscus-mount]');
  const status = container?.querySelector<HTMLElement>('[data-giscus-status]');
  const retry = container?.querySelector<HTMLButtonElement>('[data-giscus-retry]');

  if (container && mount && status && retry) {
    const themeFor = (dark: boolean) => (dark ? 'dark_dimmed' : 'light');
    const fallback = document.querySelector<HTMLElement>('[data-giscus-fallback]');
    let state: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';
    let timer: number | undefined;
    let script: HTMLScriptElement | undefined;

    // giscus 出错时会在 iframe 里显示错误文案，同时通过 postMessage 报错；
    // 这里把出错的 iframe 撤掉，换成能用的 GitHub 入口。
    const fail = (message = '在线评论暂时无法加载。') => {
      if (state === 'failed') return;
      state = 'failed';
      window.clearTimeout(timer);
      script?.remove();
      mount.replaceChildren();
      mount.hidden = true;
      status.hidden = false;
      status.textContent = message;
      retry.hidden = false;
      if (fallback) fallback.hidden = false;
    };

    const load = () => {
      if (state !== 'idle') return;
      state = 'loading';
      timer = window.setTimeout(fail, 30_000);
      script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';

      for (const key of [
        'repo', 'repoId', 'category', 'categoryId', 'mapping',
        'reactionsEnabled', 'inputPosition', 'lang',
      ]) {
        script.dataset[key] = container.dataset[key] ?? '';
      }
      // 不开 strict（严格标题匹配）：首次访问时页面还没有对应的 Discussion，
      // 开了 strict 会直接报 "Discussion not found"，评论框都出不来。
      script.dataset.emitMetadata = '0';
      // 已在外层按可见范围加载，iframe 不再二次懒加载，避免超时误报。
      script.dataset.loading = 'eager';
      script.dataset.theme = themeFor(document.documentElement.classList.contains('dark'));
      script.onerror = () => fail('在线评论暂时无法加载。');
      script.onload = () => {
        if (state === 'loading') status.textContent = '正在连接 GitHub 评论…';
      };
      container.append(script);
    };

    // client.js 会注册全局消息监听，整页重载可避免重复加载产生旧 iframe 的监听残留。
    retry.addEventListener('click', () => window.location.reload());

    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://giscus.app' || !event.data || typeof event.data !== 'object') {
        return;
      }
      const frame = mount.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!frame || event.source !== frame.contentWindow) return;

      const payload = event.data.giscus;
      if (!payload || typeof payload !== 'object') return;

      // 应用没装、Discussions 关了、分类 ID 失效才会走到这里。
      // 注意 "Discussion not found" 是正常状态——这篇还没有第一条评论，
      // 组件自己会渲染空评论区，不能当成故障处理。
      if (typeof payload.error === 'string' && payload.error) {
        if (/discussion not found/i.test(payload.error)) return;
        fail(
          payload.error.includes('not installed')
            ? '评论区需要先在博客仓库安装 giscus 应用，暂时可以用下面的 GitHub 入口留言。'
            : `在线评论加载失败：${payload.error}`,
        );
        return;
      }
      if (state === 'loading' && typeof payload.resizeHeight === 'number' && payload.resizeHeight > 0) {
        state = 'ready';
        window.clearTimeout(timer);
        status.hidden = true;
      }
    });

    document.addEventListener('theme-change', (event) => {
      const isDark = (event as CustomEvent<{ isDark: boolean }>).detail?.isDark;
      if (typeof isDark !== 'boolean') return;
      const frame = mount.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: themeFor(isDark) } } },
        'https://giscus.app',
      );
    });

    if (container.dataset.lazy === 'true' && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            load();
          }
        },
        { rootMargin: '200px' },
      );
      observer.observe(container);
    } else {
      load();
    }
  }
</script>
