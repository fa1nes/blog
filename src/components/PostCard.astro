---
import { Image } from 'astro:assets';
import type { Post } from '~/lib/posts';
import { postSlug, postSummary, postReadingTime } from '~/lib/posts';
import { formatISODate } from '~/lib/format';
import { categoryPath, href, postPath, tagPath } from '~/lib/url';
import { features } from '~/site.config';
import Icon from '~/components/Icon.astro';

interface Props {
  post: Post;
  dense?: boolean;
}

const { post, dense = false } = Astro.props;
const { title, pubDate, category, tags, pinned, cover, coverAlt } = post.data;
const summary = postSummary(post);
const minutes = postReadingTime(post);
const link = postPath(postSlug(post));
const thumbClass =
  'h-14 w-[5.5rem] rounded-lg border border-line object-cover transition-opacity group-hover:opacity-85 sm:h-[5.25rem] sm:w-[8.25rem]';
---

<article class="post-item group border-b border-line py-7 last:border-0">
  <div class="flex items-start gap-4 sm:gap-6">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1 meta-text">
        <span class="flex items-center gap-1.5">
          <Icon name="calendar" size={13} class="text-ink-faint" />
          <time datetime={pubDate.toISOString()}>{formatISODate(pubDate)}</time>
        </span>
        <a href={categoryPath(category)} class="flex items-center gap-1.5 transition-colors hover:text-accent">
          <Icon name="folder" size={13} class="text-ink-faint" />
          {category}
        </a>
        {
          features.readingTime && (
            <span class="flex items-center gap-1.5">
              <Icon name="clock" size={13} class="text-ink-faint" />
              {minutes} 分钟
            </span>
          )
        }
        {
          pinned && (
            <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[0.7rem] font-medium text-accent">
              置顶
            </span>
          )
        }
      </div>

      <h2 class="mt-2 text-[1.3rem] font-bold leading-snug tracking-tight">
        <a href={link} class="text-accent decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-hover hover:underline focus-visible:underline">
          {title}
        </a>
      </h2>

      {
        !dense && summary && (
          <p class="mt-2 line-clamp-2 text-[0.95rem] leading-relaxed text-ink-soft">{summary}</p>
        )
      }
    </div>

    {
      cover && (
        <a href={link} class="shrink-0 overflow-hidden rounded-lg" tabindex="-1" aria-hidden="true">
          {typeof cover === 'string' ? (
            <img src={href(cover)} alt={coverAlt ?? title} class={thumbClass} loading="lazy" />
          ) : (
            <Image
              src={cover}
              alt={coverAlt ?? title}
              widths={[176, 264]}
              sizes="(min-width: 40rem) 8.25rem, 5.5rem"
              class={thumbClass}
              loading="lazy"
            />
          )}
        </a>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a href={tagPath(tag)} class="tag-chip">
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
