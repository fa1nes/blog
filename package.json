{
  "name": "astro-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "一个性能优先的现代静态个人博客",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "content:pull": "node scripts/fetch-content.mjs",
    "start": "astro dev",
    "build": "node scripts/fetch-content.mjs && node scripts/post-og.mjs && astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "check": "npm test && astro check",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test",
    "test:json-ld": "node --test scripts/json-ld.test.mjs",
    "sync": "astro sync",
    "setup": "node scripts/setup.mjs",
    "og": "node scripts/generate-og.mjs && node scripts/post-og.mjs",
    "og:posts": "node scripts/post-og.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/markdown-satteri": "0.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "astro-pagefind": "^2.0.1",
    "github-slugger": "^2.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "parse5": "7.3.0",
    "typescript": "^6.0.3"
  }
}
